rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profiles Collection: cada usuário só pode ler, criar e alterar o próprio documento
    match /users/{userId} {
      // Leitura individual apenas pelo próprio usuário dono da conta
      allow get: if isOwner(userId);
      // Impede listagem aberta de todos os perfis de usuários
      allow list: if false;

      // Criação de perfil no cadastro
      allow create: if isOwner(userId) && isValidUser(incoming());

      // Atualização de dados cadastrais (nome, cargo, escola, data de atualização)
      allow update: if isOwner(userId) 
        && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'schoolName', 'updatedAt'])
        && incoming().uid == existing().uid
        && incoming().email == existing().email;

      // Exclusão permitida apenas pelo próprio usuário
      allow delete: if isOwner(userId);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string && data.uid == request.auth.uid
        && data.email is string && data.email.size() > 3 && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('role' in data) || (data.role is string && data.role.size() <= 60))
        && (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 150))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // School Questionnaire Submissions
    match /submissions/{submissionId} {
      // Permite leitura pública ou autenticada para agregação dos gráficos de convivência escolar
      allow read: if true;

      // Permite aos estudantes registrarem respostas válidas
      allow create: if isValidSubmission(request.resource.data);

      // Não permite adulteração de respostas já enviadas
      allow update: if false;
      // Permite exclusão de respostas pela gestão escolar
      allow delete: if true;
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['id', 'timestamp', 'studentInfo', 'answers'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 100
        && data.timestamp is string && data.timestamp.size() <= 100
        && data.studentInfo is map
        && data.studentInfo.keys().hasAll(['grade', 'shift', 'isAnonymous'])
        && data.studentInfo.grade is string && data.studentInfo.grade.size() <= 100
        && data.studentInfo.shift is string && data.studentInfo.shift.size() <= 50
        && data.studentInfo.isAnonymous is bool
        && data.answers is map;
    }
  }
}
